{
  "name": "walletkit-web-vite-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldcoin/walletkit"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "walletkit:local": "bun run --cwd ../../web/walletkit build && bun link --cwd ../../web/walletkit && bun link --no-save walletkit-web",
    "walletkit:published": "bun install --frozen-lockfile --force"
  },
  "dependencies": {
    "walletkit-web": "0.21.3"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "^8.2.2"
  }
}
